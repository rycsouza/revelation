# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).

# --- Supabase (obrigatório para criar revelações; sem isso, só as demos funcionam) ---
# Supabase → Project Settings → Data API / API Keys
SUPABASE_URL=
# Chave "service_role" (ou "secret"). Nunca exponha no navegador: só o servidor usa.
SUPABASE_SERVICE_ROLE_KEY=

# --- Limpeza automática (obrigatório em produção) ---
# Qualquer texto aleatório longo. A Vercel manda ele no cron diário.
CRON_SECRET=

# --- Opcionais (aparecem no site) ---
# Domínio público, se não usar o padrão da Vercel. Ex.: https://revelacao.com.br
NEXT_PUBLIC_SITE_URL=
# E-mail para denúncias e pedidos de exclusão (link "Denunciar conteúdo" e página de privacidade)
NEXT_PUBLIC_CONTACT_EMAIL=
# Link do repositório no GitHub (rodapé)
NEXT_PUBLIC_REPO_URL=
# Seu nome e link (rodapé: "Feito por diversão por ...")
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_URL=
